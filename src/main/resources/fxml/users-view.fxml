<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.biblioteca.UsersView" spacing="15" style="-fx-padding: 20;">
    <Label text="Gestión de Usuarios" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Apellidos:" GridPane.rowIndex="1"/>
        <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Correo electrónico:" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Teléfono:" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Dirección:" GridPane.rowIndex="4"/>
        <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Fecha de registro:" GridPane.rowIndex="5"/>
        <DatePicker fx:id="dpFechaRegistro" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label text="Estado:" GridPane.rowIndex="6"/>
        <TextField fx:id="txtEstado" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label fx:id="lblMensaje" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Guardar" onAction="#saveUser"/>
        <Button text="Limpiar" onAction="#clearFields"/>
    </HBox>
    <Button text="Volver al Inicio" onAction="#goBack"/>
</VBox>
